# Server-side only. Never use VITE_ for this key.
MODEL_API_KEY=
MOBBS_PROVIDER_MODE=standard
APP_ORIGIN=http://localhost:8000
POSTGRES_PASSWORD=replace-with-a-long-local-password
S3_ACCESS_KEY=mobbs-local
S3_SECRET_KEY=replace-with-a-long-local-storage-password
S3_BUCKET=mobbs
# Used by native startup or a host; Compose supplies its internal addresses.
DATABASE_URL=postgresql://mobbs:replace-with-a-long-local-password@localhost:5432/mobbs
S3_ENDPOINT=http://localhost:9000
